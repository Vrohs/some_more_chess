# Maintainer: Vivek Rohtasvi <info.rohsgaming536@gmail.com>
pkgname=omachess
pkgver=0.1.0
pkgrel=1
pkgdesc="Chess study with spaced repetition and solve-time tracking"
arch=('x86_64' 'aarch64')
_repo=some_more_chess
url="https://github.com/Vrohs/$_repo"
license=('MIT')
depends=('gtk4' 'libadwaita')
makedepends=('cargo')
# SQLite is compiled in from source by rusqlite's bundled feature. Arch enables
# LTO by default, and the C objects cc produces then carry bitcode the Rust
# linker cannot resolve, so every sqlite3_* symbol comes out undefined.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$_repo-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    # Belt and braces: the release tarball excludes this, but a build from a
    # working tree would otherwise hit mise's untrusted-config refusal.
    rm -f .mise.toml
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_repo-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$_repo-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    # The domain core carries the scheduling and grading logic; it needs no display.
    cargo test --frozen --release -p omachess-core
}

package() {
    cd "$_repo-$pkgver"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "packaging/omachess.desktop" \
        "$pkgdir/usr/share/applications/omachess.desktop"
    install -Dm644 "packaging/omachess.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/omachess.svg"
    install -Dm644 "themes/omachess.css.tpl" \
        "$pkgdir/usr/share/$pkgname/themes/omachess.css.tpl"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
